{
  "agent": {
    "maxSteps": 60,
    "maxRunMs": 600000,
    "maxHistoryItems": 12,
    "stepDelayMs": 300,
    "snapshotRetryDelayMs": 1000,
    "decisionRetryCount": 2,
    "decisionRetryBaseDelayMs": 250,
    "decisionRetryBackoffMultiplier": 1.8,
    "decisionRetryJitterRatio": 0.05,
    "maxDecisionRetryDelayMs": 4000,
    "retryOnNonTransientDecisionErrors": false,
    "slowStepWarnMs": 12000,
    "allowModelFallback": true,
    "defaultStartUrl": "https://www.google.com",
    "guards": {
      "enabled": true,
      "recentActionWindow": 8,
      "maxRepeatedActionBeforeRewrite": 2,
      "maxRepeatedScrollBeforeHotkey": 6,
      "scrollBreakKeyUp": "Home",
      "scrollBreakKeyDown": "End"
    }
  },
  "browser": {
    "headless": false,
    "slowMoMs": 0,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "userDataDir": ".browser-profile",
    "navigationTimeoutMs": 45000,
    "navigationWaitUntil": "domcontentloaded",
    "actionTimeoutMs": 15000,
    "waitAfterActionMs": 500,
    "typeDelayMs": 10,
    "defaultScrollAmountPx": 600,
    "clickFallbackToHrefOnTimeout": true,
    "typeActionAllowedInputTypes": [
      "text",
      "search",
      "email",
      "password",
      "tel",
      "url",
      "number"
    ],
    "actionLimits": {
      "maxTypeTextLength": 1200,
      "maxScrollAmountPx": 3000,
      "maxWaitMs": 30000,
      "allowedNavigationProtocols": [
        "http:",
        "https:"
      ],
      "blockedHostPatterns": [
        "localhost",
        "127.0.0.1",
        "0.0.0.0",
        "169.254.169.254",
        "metadata.google.internal"
      ],
      "allowPrivateNetworkHosts": false
    },
    "snapshotWaitUntil": "domcontentloaded",
    "snapshotWaitTimeoutMs": 1500,
    "adoptLatestPageOnNewTab": true,
    "snapshot": {
      "maxElements": 80,
      "textExcerptLength": 1800,
      "includeInputs": true,
      "includeButtons": true,
      "includeLinks": true,
      "includeHeadings": true,
      "onlyViewportElements": true,
      "viewportMarginPx": 120
    }
  },
  "model": {
    "provider": "anthropic_compatible",
    "fallbackProvider": "rule_based",
    "fallbackMode": "non_transient_only",
    "apiBaseUrl": "https://api.z.ai/api/anthropic",
    "apiKeyEnv": "MODEL_API_KEY",
    "modelNameEnv": "MODEL_NAME",
    "providerEnv": "MODEL_PROVIDER",
    "baseUrlEnv": "MODEL_API_BASE_URL",
    "modelName": "glm-4.7",
    "temperature": 0.2,
    "maxTokens": 1400,
    "requestTimeoutMs": 45000,
    "transientErrorKeywords": [
      "timeout",
      "temporarily unavailable",
      "rate limit",
      "too many requests",
      "connection",
      "network",
      "503",
      "504",
      "429"
    ],
    "connectionCheckSystemPrompt": "You are a healthcheck assistant. Reply with short plain text only.",
    "connectionCheckUserPrompt": "Return exactly: GLM_CONNECTION_OK",
    "connectionCheckMaxTokens": 40,
    "promptLimits": {
      "maxHistoryItems": 8,
      "maxActionResultLength": 260,
      "maxThoughtSummaryLength": 180,
      "maxReasoningLength": 240,
      "maxAttentionHints": 6,
      "maxElementReasons": 4
    },
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 3,
      "cooldownMs": 20000,
      "tripOnTransientOnly": false
    }
  },
  "safety": {
    "requireConfirmationRiskLevels": [
      "destructive",
      "financial",
      "external_send"
    ],
    "keywordTriggers": [
      "удал",
      "delete",
      "remove",
      "trash",
      "spam",
      "pay",
      "оплат",
      "purchase",
      "куп",
      "send",
      "отправ",
      "submit",
      "confirm"
    ]
  },
  "logging": {
    "jsonlPath": "logs/agent-events.jsonl",
    "debugTextPath": "logs/agent-debug.txt",
    "jsonlIncludeMonitorData": false,
    "jsonlIncludeDebugData": false,
    "showObservationDetails": true,
    "timeFormat": "iso",
    "rotation": {
      "enabled": true,
      "maxFileSizeBytes": 10485760,
      "maxArchiveFiles": 5
    },
    "redaction": {
      "enabled": true,
      "keys": [
        "authorization",
        "api_key",
        "apiKey",
        "x-api-key",
        "token",
        "auth",
        "password",
        "cookie",
        "set-cookie",
        "session"
      ],
      "mask": "***REDACTED***"
    },
    "console": {
      "visibleLevels": [
        "status",
        "action",
        "approval",
        "success",
        "warn",
        "error"
      ],
      "maxInlineValueLength": 120,
      "maxInlineArrayItems": 4,
      "maxInlineObjectKeys": 8,
      "maxInlineLineLength": 220,
      "neverTruncateKeys": [
        "summary",
        "question",
        "resumeHint",
        "text",
        "result"
      ],
      "actionStartLogActions": [],
      "decisionDigest": {
        "enabled": true,
        "mode": "on_change",
        "repeatReminderEvery": 4,
        "thoughtMaxLength": 150,
        "reasoningMaxLength": 150,
        "successCriteriaMaxLength": 130
      }
    },
    "colors": {
      "system": "cyan",
      "status": "blue",
      "observation": "gray",
      "decision": "magenta",
      "action": "blueBright",
      "approval": "yellow",
      "success": "green",
      "warn": "yellowBright",
      "error": "redBright"
    }
  },
  "cli": {
    "banner": [
      "Personal Browser Agent",
      "Команды: /run <задача>, /pause, /resume, /continue, /stop, /approve, /deny, /status, /help, /exit",
      "Можно просто ввести задачу без /run, если агент сейчас не запущен. После ask_user/recovery-паузы нажми Enter для продолжения."
    ],
    "prompt": "agent> ",
    "unknownCommandMessage": "Неизвестная команда. Используй /help.",
    "busyMessage": "Агент уже выполняет задачу. Используй /pause, /stop или /status.",
    "idleMessage": "Сейчас нет активной задачи. Введи /run <задача>."
  },
  "prompts": {
    "system": "Ты личный автономный браузерный агент. Выбирай только следующий лучший шаг, учитывая текущее состояние страницы и цель. Не выдумывай результаты действий. Если есть неопределенность, сначала собери больше наблюдений или задай вопрос пользователю. Не выполняй потенциально деструктивные, финансовые или отправляющие действия без явной пометки риска.",
    "outputSchemaHint": "Верни только JSON без markdown и без дополнительных комментариев.",
    "actionPolicy": "Используй один из action.name: navigate, click, type, press, scroll, wait, finish, ask_user. Для click/type всегда используй elementId из snapshot (формат e-N) или domId из snapshot, но не выдумывай новые идентификаторы. Для type выбирай только текстовые поля (inputType: text/search/email/password/tel/url/number, textarea, contenteditable). Никогда не делай type в checkbox/radio/button/input без текстового назначения. Не повторяй один и тот же action+args больше двух шагов подряд, если URL не меняется. Если click не дал переход, а у элемента есть href, пробуй navigate на этот href. При признаках зацикливания избегай элементов region=header/footer/nav и выбирай следующий шаг из main-контента. Для wait передавай args.ms в миллисекундах."
  },
  "context": {
    "maxRankedElements": 14,
    "maxTextExcerptForModel": 1000,
    "keywordMinLength": 3,
    "recentHistoryDepth": 6,
    "stopWords": [
      "для",
      "как",
      "что",
      "чтобы",
      "если",
      "или",
      "это",
      "and",
      "the",
      "with",
      "from",
      "into",
      "this",
      "that"
    ],
    "nonTextInputTypes": [
      "checkbox",
      "radio",
      "button",
      "submit",
      "reset",
      "file",
      "range",
      "color",
      "date",
      "datetime-local",
      "month",
      "week",
      "time",
      "hidden",
      "image"
    ],
    "loopHints": {
      "historyWindow": 8,
      "repeatActionThreshold": 3,
      "sameUrlThreshold": 6,
      "failedActionHintLimit": 3
    },
    "scoreWeights": {
      "textMatch": 3,
      "ariaMatch": 2,
      "placeholderMatch": 2,
      "hrefMatch": 1,
      "interactiveRoleBonus": 1,
      "recentlyUsedBonus": 0.2,
      "repeatedRecentUsePenalty": -0.9,
      "recentlyFailedPenalty": -1.5,
      "nonMainRegionPenalty": -1.2,
      "disabledPenalty": -2,
      "nonTextInputPenalty": -2.5,
      "lowSignalElementPenalty": -0.8
    }
  },
  "subAgents": {
    "enabled": true,
    "roles": {
      "navigator": "Роль Navigator: выбирай маршрут и последовательность переходов по страницам, когда текущий экран не даёт прямого пути к цели.",
      "extractor": "Роль Extractor: выделяй важные элементы и данные на странице, отбрасывай нерелевантное, готовь основу для точного следующего действия.",
      "action": "Роль Action: делай конкретный следующий шаг в интерфейсе, который максимально приближает к завершению задачи.",
      "verifier": "Роль Verifier: проверь, что предыдущий шаг дал ожидаемый эффект, и при расхождении выбери корректирующее действие."
    }
  },
  "recovery": {
    "enabled": true,
    "retrySameActionOnTransientErrors": true,
    "transientErrorKeywords": [
      "timeout",
      "detached",
      "target closed",
      "navigation",
      "network",
      "context destroyed",
      "element is not attached"
    ],
    "popupDismissKey": "Escape",
    "waitMsAfterFailure": 1200,
    "maxWaitMsAfterFailure": 10000,
    "backoffMultiplier": 1.6,
    "jitterRatio": 0.05,
    "scrollRecoveryAmount": 420,
    "maxAutoRecoveryActions": 3,
    "maxConsecutiveFailuresBeforePause": 4
  }
}
