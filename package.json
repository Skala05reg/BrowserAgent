{
  "name": "personal-browser-agent",
  "version": "0.1.0",
  "description": "Personal browser automation agent with live decision logging, pause/resume control, and safety confirmations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "model:check": "tsx src/scripts/checkModelConnection.ts",
    "logs:analyze": "tsx src/scripts/analyzeRuns.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "dotenv": "^16.6.1",
    "playwright": "^1.54.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
